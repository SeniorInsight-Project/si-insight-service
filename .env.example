# Copie para .env e preencha. O .env não é versionado.

# PostgreSQL (o Flyway cria o schema "insight" se ele não existir)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=insight
DB_PASSWORD=

# RabbitMQ (o serviço declara a exchange topic "si.events", a fila "insight.q" e a dead-letter "insight.q.dlq")
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=insight
RABBITMQ_PASSWORD=

# Redis (cache do semáforo: insight:semaforo:{idosoId}, TTL de 15 min)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak: precisa ser igual ao claim "iss" dos tokens e acessível pelo serviço
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight
# Opcional: busca as chaves por outro endereço (ex.: dentro do Compose), sem mudar o issuer validado
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://keycloak:8080/realms/seniorinsight/protocol/openid-connect/certs

# Gemini: chave só por variável de ambiente (Secret Manager em produção)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Porta HTTP do serviço
SERVER_PORT=8080
